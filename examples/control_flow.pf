fun main() -> unit:
    var total = 0
    for n in range(1, 8):
        if n == 2:
            continue
        if n == 6:
            break
        total = total + n
    print(total)

    var i = 3
    while i > 0:
        print(i)
        i = i - 1

    match total:
        case 13:
            print("matched")
        case _:
            print("unexpected")

    for n in range(3, 0, -1):
        print(n)
