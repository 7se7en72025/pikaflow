fun main() -> unit:
    match (20, 22):
        case (left, right):
            print(left + right)

    match [7, 8]:
        case [only]:
            print("wrong length")
        case [first, second]:
            print(first + second)

    match [(1, 2), (3, 4)]:
        case [(a, b), (_, c)]:
            print(a + c)

    let good: Result[[i64], str] = ok([40, 2])
    match good:
        case ok([first, second]):
            print(first + second)
        case err(message):
            print(message)

    let bad: Result[i64, str] = err("expected failure")
    match bad:
        case ok(value):
            print(value)
        case err(message):
            print(message)

    match 10:
        case range(0, 10):
            print("wrong range")
        case range(10, 20):
            print("ten")
