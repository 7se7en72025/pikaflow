option(PIKAFLOW_ENABLE_SANITIZERS "Instrument PikaFlow host code with Linux Clang ASan and UBSan" OFF)
set(PF_SANITIZERS_ENABLED 0)
if(PIKAFLOW_ENABLE_SANITIZERS)
    if(CMAKE_CROSSCOMPILING OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR MSVC OR
       NOT CMAKE_C_COMPILER_ID STREQUAL "Clang" OR
       NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        message(FATAL_ERROR "PIKAFLOW_ENABLE_SANITIZERS requires native Linux Clang C and C++ drivers")
    endif()
    include(CMakePushCheckState)
    include(CheckCSourceCompiles)
    include(CheckCXXSourceCompiles)
    cmake_push_check_state(RESET)
    set(CMAKE_REQUIRED_FLAGS "-fsanitize=address,undefined -fno-sanitize-recover=all")
    check_c_source_compiles("int main(void) { return 0; }" PIKAFLOW_C_SANITIZERS_AVAILABLE)
    check_cxx_source_compiles("int main() { return 0; }" PIKAFLOW_CXX_SANITIZERS_AVAILABLE)
    cmake_pop_check_state()
    if(NOT PIKAFLOW_C_SANITIZERS_AVAILABLE OR NOT PIKAFLOW_CXX_SANITIZERS_AVAILABLE)
        message(FATAL_ERROR "Clang ASan/UBSan compile and link runtimes are required")
    endif()
    set(PF_SANITIZERS_ENABLED 1)
    set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
    add_compile_options(-O1 -g -fno-omit-frame-pointer
        -fsanitize=address,undefined -fno-sanitize-recover=all)
    add_link_options(-fsanitize=address,undefined)
    message(STATUS "PikaFlow host ASan/UBSan enabled; prebuilt LLVM and generated IR remain outside instrumentation")
endif()
