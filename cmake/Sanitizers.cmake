option(PIKAFLOW_ENABLE_SANITIZERS "Instrument PikaFlow host code with Linux Clang ASan and UBSan" OFF)
set(PF_SANITIZERS_ENABLED 0)
if(PIKAFLOW_ENABLE_SANITIZERS)
    if(CMAKE_CROSSCOMPILING OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR MSVC OR
       NOT CMAKE_C_COMPILER_ID STREQUAL "Clang" OR
       NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        message(FATAL_ERROR "PIKAFLOW_ENABLE_SANITIZERS requires native Linux Clang C and C++ drivers")
    endif()
    include(CMakePushCheckState)
    include(CheckCSourceCompiles)
    include(CheckCXXSourceCompiles)
    cmake_push_check_state(RESET)
    set(CMAKE_REQUIRED_FLAGS "-fsanitize=address,undefined -fno-sanitize-recover=all")
    check_c_source_compiles("int main(void) { return 0; }" PIKAFLOW_C_SANITIZERS_AVAILABLE)
    check_cxx_source_compiles("int main() { return 0; }" PIKAFLOW_CXX_SANITIZERS_AVAILABLE)
    cmake_pop_check_state()
    if(NOT PIKAFLOW_C_SANITIZERS_AVAILABLE OR NOT PIKAFLOW_CXX_SANITIZERS_AVAILABLE)
        message(FATAL_ERROR "Clang ASan/UBSan compile and link runtimes are required")
    endif()
    set(PF_SANITIZERS_ENABLED 1)
    set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
    add_compile_options(-O1 -g -fno-omit-frame-pointer
        -fsanitize=address,undefined -fno-sanitize-recover=all)
    add_link_options(-fsanitize=address,undefined)
    message(STATUS "PikaFlow host ASan/UBSan enabled; LLVM backend requires a matching SDK; generated IR is not blanket-instrumented")
endif()

function(pikaflow_require_sanitized_llvm)
    if(NOT DEFINED LLVM_BUILD_BINARY_DIR OR NOT EXISTS "${LLVM_BUILD_BINARY_DIR}/CMakeCache.txt")
        message(FATAL_ERROR "Sanitized LLVM backend requires a build-tree LLVM SDK with its CMakeCache.txt: configure LLVM_USE_SANITIZER=Address;Undefined using the same Clang C/C++ drivers. Installed or unknown SDKs cannot prove sanitizer compatibility.")
    endif()
    file(REAL_PATH "${LLVM_BUILD_BINARY_DIR}" llvm_build)
    file(REAL_PATH "${LLVM_DIR}" llvm_config)
    cmake_path(IS_PREFIX llvm_build "${llvm_config}" NORMALIZE config_in_build)
    if(NOT config_in_build)
        message(FATAL_ERROR "Selected LLVM_DIR is not inside its LLVM_BUILD_BINARY_DIR; sanitizer SDK compatibility cannot be verified")
    endif()
    # LLVMConfig does not export LLVM_USE_SANITIZER; read the selected build's cache, not caller overrides.
    set(entries LLVM_USE_SANITIZER CMAKE_C_COMPILER CMAKE_CXX_COMPILER
        LLVM_BUILD_LLVM_DYLIB LLVM_LINK_LLVM_DYLIB)
    foreach(entry IN LISTS entries)
        set(sdk_${entry} "")
    endforeach()
    load_cache("${llvm_build}" READ_WITH_PREFIX sdk_ ${entries})
    set(sanitizers "${sdk_LLVM_USE_SANITIZER}")
    list(SORT sanitizers)
    if(NOT "${sanitizers}" STREQUAL "Address;Undefined")
        message(FATAL_ERROR "LLVM SDK sanitizer mismatch: its cache must set LLVM_USE_SANITIZER=Address;Undefined (found '${sdk_LLVM_USE_SANITIZER}'). Rebuild LLVM with the matching Clang sanitizer toolchain.")
    endif()
    foreach(language C CXX)
        set(sdk_compiler "${sdk_CMAKE_${language}_COMPILER}")
        unset(sdk_compiler_path)
        if(sdk_compiler AND NOT IS_ABSOLUTE "${sdk_compiler}")
            set(sdk_compiler_path "sdk_compiler_path-NOTFOUND")
            find_program(sdk_compiler_path NAMES "${sdk_compiler}" NO_CACHE)
        else()
            set(sdk_compiler_path "${sdk_compiler}")
        endif()
        if(NOT EXISTS "${sdk_compiler_path}")
            message(FATAL_ERROR "LLVM SDK cache has no usable CMAKE_${language}_COMPILER; sanitizer toolchain compatibility cannot be verified")
        endif()
        file(REAL_PATH "${sdk_compiler_path}" sdk_compiler_real)
        file(REAL_PATH "${CMAKE_${language}_COMPILER}" compiler_real)
        if(NOT sdk_compiler_real STREQUAL compiler_real)
            message(FATAL_ERROR "LLVM SDK sanitizer compiler mismatch: ${sdk_compiler} differs from ${CMAKE_${language}_COMPILER}. Use the same Clang C/C++ drivers for LLVM and PikaFlow.")
        endif()
    endforeach()
    set(PF_SANITIZED_LLVM_DYLIB OFF PARENT_SCOPE)
    if(sdk_LLVM_BUILD_LLVM_DYLIB AND sdk_LLVM_LINK_LLVM_DYLIB AND TARGET LLVM)
        set(PF_SANITIZED_LLVM_DYLIB ON PARENT_SCOPE)
    endif()
endfunction()
